{
    "V": {
        "sense": {
            "ac": "V{note}-{vhigh}-{vlow}",
            "dc": "V{note}-{vhigh}-{vlow}"
        },
        "source": {
            "fixed": {
                "dc": "Vfix{fixv}V-{vhigh}-{vlow}",
                "ac": "Vfix{fixv}V-freq{freq}Hz-{vhigh}-{vlow}"
            },
            "sweep": {
                "dc": "Vmax{maxv}V-step{stepv}V-{vhigh}-{vlow}-swpmode{mode}",
                "ac": "Vmax{maxv}V-step{stepv}V-freq{freq}Hz-{vhigh}-{vlow}-swpmode{mode}"
            },
            "biased":{
                "ac": "Vac{fixv}V-freq{freq}Hz-Vdcmax{maxv}V-step{stepv}V-{vhigh}-{vlow}-swpmode{mode}"
            }
        }
    },
    "I": {
        "sense": {
            "ac": "I{note}-{iin}-{iout}",
            "dc": "I{note}-{iin}-{iout}"
        },
        "source": {
            "fixed": {
                "dc": "Ifix{fixi}A-{iin}-{iout}",
                "ac": "Ifix{fixi}A-freq{freq}Hz-{iin}-{iout}",
                "pulse": "Ifixpulse-bot{boti}A-top{topi}A-width{twidth}s-freq{freq}Hz-count{count}"
            },
            "sweep": {
                "dc": "Imax{maxi}A-step{stepi}A-{iin}-{iout}-swpmode{mode}",
                "ac": "Imax{maxi}A-step{stepi}A-freq{freq}Hz-{iin}-{iout}-swpmode{mode}",
                "pulse": "Iswppulse-botusu0-top-min{topmini}A-max{topmaxi}A-step{stepi}A-swpmode{swpmode}-width{twidth}s-freq{freq}Hz-count{count}"
            },
            "biased":{
                "ac": "Iac{fixi}A-freq{freq}Hz-Idcmax{maxi}A-step{stepi}A-{ihigh}-{ilow}-swpmode{mode}"
            }
        }
    },
    "T": {
        "fixed": "Temp{fixT}K",
        "sweep": "Temp{Tstart}-{Tstop}K-step{stepT}K-swpmode{mode}",
        "vary": "Temp{Tstart}-{Tstop}K"
    },
    "B": {
        "fixed": "B{fixB}T",
        "sweep": "B{Bstart}-{Bstop}T-step{stepB}T-swpmode{mode}",
        "vary": "B{Bstart}-{Bstop}T"
    },
    "a": {
        "fixed": "a{fixa}deg",
        "sweep": "a{astart}-{astop}deg-step{stepa}deg-swpmode{mode}",
        "vary": "a{astart}-{astop}deg"
    }
}